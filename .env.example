# Template only: provide values for your local environment; no real credentials here.
# Spring Boot currently does not automatically load .env.
# An external/local mechanism must supply these variables to the application process.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Object Storage provider: disabled or minio
DXOS_OBJECT_STORAGE_PROVIDER=

# MinIO configuration
# Store real credentials privately, never commit secrets.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_STORAGE_ENDPOINT=
MINIO_STORAGE_REGION=us-east-1
MINIO_STORAGE_ACCESS_KEY=
MINIO_STORAGE_SECRET_KEY=
MINIO_STORAGE_BUCKET=
MINIO_STORAGE_KEY_PREFIX=
MINIO_STORAGE_STAGING_DIRECTORY=
MINIO_STORAGE_MAX_OBJECT_BYTES=67108864
MINIO_STORAGE_MAX_METADATA_BYTES=1800
MINIO_STORAGE_MAX_KEY_BYTES=1024
MINIO_STORAGE_CONNECT_TIMEOUT=PT10S
MINIO_STORAGE_READ_TIMEOUT=PT60S
MINIO_STORAGE_REQUEST_TIMEOUT=PT120S
MINIO_STORAGE_ALLOW_INSECURE_HTTP=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
