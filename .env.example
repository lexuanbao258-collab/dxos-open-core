# Template only: provide values for your local environment; no real credentials here.
# Spring Boot currently does not automatically load .env.
# An external/local mechanism must supply these variables to the application process.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Required when DXOS_OBJECT_STORAGE_PROVIDER=supabase; placeholders only.
DXOS_OBJECT_STORAGE_PROVIDER=
SUPABASE_STORAGE_REST_BASE_URL=
SUPABASE_STORAGE_API_KEY=
# secret or service-role (legacy JWT); no Supabase Auth user session.
SUPABASE_STORAGE_API_KEY_MODE=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_KEY_PREFIX=
SUPABASE_STORAGE_MAX_OBJECT_BYTES=
SUPABASE_STORAGE_MAX_METADATA_BYTES=
SUPABASE_STORAGE_MAX_KEY_BYTES=
SUPABASE_STORAGE_MAX_RESPONSE_BYTES=
SUPABASE_STORAGE_STAGING_DIRECTORY=
SUPABASE_STORAGE_CONNECT_TIMEOUT=
SUPABASE_STORAGE_REQUEST_TIMEOUT=
