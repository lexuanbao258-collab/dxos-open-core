# Copy to infra/.env.staging (gitignored) and replace values locally.
# Never commit real credentials, keys, tokens, database exports or uploaded files.
#
# This is NOT a working application environment until approved DB migrations,
# runtime grants, Identity/Gateway security and the selected Storage adapter
# are present. See docs/deployment/aws-staging.md.
STAGING_PG_DATABASE=dxos_staging
STAGING_PG_OWNER=dxos_owner
STAGING_PG_PASSWORD=
STAGING_DB_RUNTIME_USER=dxos_runtime
STAGING_DB_RUNTIME_PASSWORD=
DXOS_WORKFLOW_SCHEMA=dxos_wf25_smoke_01

# Explicit loopback bindings: NOT publicly accessible from EC2 security groups.
STAGING_PG_LOOPBACK_PORT=55426
STAGING_BACKEND_LOOPBACK_PORT=18080
