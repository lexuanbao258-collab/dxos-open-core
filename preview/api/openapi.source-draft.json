              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai bearer token"
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cursor sau một UUID"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ]
      },
      "post": {
        "summary": "Tạo yêu cầu IT Helpdesk",
        "operationId": "createRequest",
        "tags": [
          "IT Helpdesk MVP"
        ],
        "description": "Employee được cấp quyền tạo; trạng thái ban đầu SUBMITTED, Workflow version 0.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã tạo yêu cầu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestView"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai bearer token"
          }
        }
      }
    },
