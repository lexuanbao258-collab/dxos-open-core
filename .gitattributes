# Consistent line endings across Windows and Linux avoid whole-file diffs.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
gradlew text eol=lf
*.sh text eol=lf
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
