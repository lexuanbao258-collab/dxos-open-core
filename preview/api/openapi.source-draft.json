  "paths": {
    "/api/v1/mvp/requests": {
      "get": {
        "summary": "Danh sách yêu cầu được phép xem",
        "operationId": "listRequests",
        "tags": [
          "IT Helpdesk MVP"
        ],
        "description": "Cursor pagination; chỉ trả về các yêu cầu người gọi được phép đọc.",
        "responses": {
          "200": {
            "description": "Thành công",
