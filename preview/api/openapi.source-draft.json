  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Keycloak access token, chỉ có hiệu lực trong môi trường đã provision đúng và được Backend cấp quyền."
      }
    },
    "schemas": {
      "CreateRequest": {
        "type": "object",
        "required": [
          "title",
          "description",
          "requestType"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "Tiêu đề sự cố",
            "maxLength": 200,
            "example": "Máy tính không kết nối Internet"
          },
          "description": {
            "type": "string",
            "description": "Mô tả",
            "maxLength": 4000,
            "example": "Máy tính phòng học không truy cập được mạng."
          },
          "requestType": {
            "type": "string",
            "enum": [
              "IT_HELPDESK"
            ]
          }
        }
      },
      "VersionCommand": {
        "type": "object",
        "required": [
          "expectedVersion"
        ],
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Phiên bản Workflow hiện tại do server cung cấp"
          }
        }
      },
      "AssignCommand": {
        "type": "object",
        "required": [
          "assigneeId",
          "expectedAssignmentVersion"
        ],
        "additionalProperties": false,
        "properties": {
          "assigneeId": {
            "type": "string",
            "description": "Canonical actor ID phải có trong eligibleAssignees",
            "minLength": 1,
            "maxLength": 1024
          },
          "expectedAssignmentVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Phiên bản phân công, tách biệt Workflow version"
          }
        }
      },
      "ResolveCommand": {
        "type": "object",
        "required": [
          "expectedVersion",
          "resolution"
        ],
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Workflow version hiện tại"
          },
          "resolution": {
            "type": "string",
            "description": "Kết quả xử lý",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "AssigneeOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Canonical actor ID"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RequestView": {
        "type": "object",
        "description": "Source-derived record com.tricore.dxos.infrastructure.workflow.HelpdeskService.RequestView",
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID request",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "requestType": {
            "type": "string",
            "enum": [
              "IT_HELPDESK"
            ]
          },
          "requesterId": {
            "type": "string"
          },
          "assigneeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignmentVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Bộ đếm phân công"
          },
          "workflowInstanceId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "TRIAGED",
              "IN_PROGRESS",
              "RESOLVED",
              "CONFIRMED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Workflow runtime version"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requesterDisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "assigneeDisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "eligibleAssignees": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/AssigneeOption"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestView"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "HistoryView": {
        "type": "object",
        "properties": {
          "transitionId": {
            "type": "string"
          },
          "sourceState": {
            "type": "string"
          },
          "targetState": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Workflow runtime version"
          },
          "occurredAt": {
            "type": "string",
            "description": "Thời điểm chuyển trạng thái",
            "format": "date-time"
          }
        }
      },
      "HistoryList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/HistoryView"
        }
      }
    }
  }
}
