{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::${MINIO_STORAGE_BUCKET}/${MINIO_STORAGE_KEY_PREFIX}/v1/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${MINIO_STORAGE_BUCKET}"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${MINIO_STORAGE_KEY_PREFIX}/v1/*"
          ]
        }
      }
    }
  ]
}
